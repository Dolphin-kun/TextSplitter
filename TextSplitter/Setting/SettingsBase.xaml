<UserControl x:Class="TextSplitter.Setting.SettingsBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TextSplitter.Setting"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Grid>
            <Label Content="元のアイテムを削除" VerticalAlignment="Center"/>
            <c:ToggleSlider Value="{Binding Source={x:Static local:TextSplitterSettings.Default}, Path=IsDeleteOriginalItem}" HorizontalAlignment="Right"/>
        </Grid>
        <Grid>
            <Label Content="分割方向" VerticalAlignment="Center"/>
            <c:EnumComboBox Value="{Binding Source={x:Static local:TextSplitterSettings.Default}, Path=SplitDirection}" EnumType="{x:Type local:SplitDirection}" Width="150" HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</UserControl>
